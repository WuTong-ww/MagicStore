  "questions": [
    [
      {
        "id": "invitation_text",
        "text": "邀请上写了什么？",
        "answer": "印好的地方是展览名称和日期。……可是背面有一行手写字：“替你留了靠窗的位置。”那是她的字，我认得，她写“窗”字总是少一点。",
        "evidence_ids": [
          "invitation_note"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "invitation"
      },
      {
        "id": "invitation_memory",
        "text": "靠窗的位置，是什么意思？",
        "answer": "以前我们在图书馆，总抢那个靠窗的位子。她看小说，我修书，一坐就是一下午。……她居然还记得。",
        "evidence_ids": [
          "shared_memory"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "invitation"
      },
      {
        "id": "invitation_assumption",
        "text": "你为什么觉得可能是群发的？",
        "answer": "展馆也发了一封正式通知，信封一模一样。我就想，也许每个人都收到了一张。……这样想，好像比较不会失望。",
        "evidence_ids": [
          "group_assumption"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "invitation"
      }
    ],
    [
      {
        "id": "letter_written",
        "text": "回信写好了吗？",
        "answer": "写好了。夹在我正在修的那本书里，已经两个星期了。邮票都贴了。",
        "evidence_ids": [
          "unfinished_letter"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "letter"
      },
      {
        "id": "letter_concern",
        "text": "是什么让你停在寄出之前？",
        "answer": "她现在过得很好，开了展览，身边有很多新朋友。我怕我突然出现，像一本旧书掉在别人干净的桌上。……她没说过不想见我，是我自己在想。",
        "evidence_ids": [
          "self_concern"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "letter"
      },
      {
        "id": "work_pace",
        "text": "修书的时候，你会怎么对待一页破掉的纸？",
        "answer": "先不急着补。先看它是怎么破的，再一点一点对齐纤维。……你是说，回信也可以这样，对吧。",
        "evidence_ids": [
          "self_concern"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "letter"
      }
    ],
    [
      {
        "id": "venue_route",
        "text": "展览的时间和入口，你核对过吗？",
        "answer": "我刚好又收到一张更新告示：展览改从侧门进。告示后面印着一句，窗边的座位仍然保留。",
        "evidence_ids": [
          "venue_notice"
        ],
        "requires_familiarity": 0,
        "legacy_topic_id": "venue"
      },
      {
        "id": "message_first",
        "text": "如果先问一句近况，你会怎么开口？",
        "answer": "大概会说……“最近好吗？展览我想去看看。”就这一句。回信太长了，我可以之后当面给她。",
        "evidence_ids": [
          "unfinished_letter"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "keep_boundary",
        "text": "怎样让你们两个都有说‘不’的余地？",
        "answer": "先问，不先去。她要是忙，就改一天。……这样谁都不会尴尬。",
        "evidence_ids": [
          "self_concern"
        ],
        "requires_familiarity": 0
      }
    ]
