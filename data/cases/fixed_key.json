  "questions": [
    [
      {
        "id": "buyer_signature",
        "text": "买家的出价单，还留着吗？",
        "answer": "留着。中介说买家不愿露面，只签了缩写：T.S.N.。我戴上眼镜看了好一会儿，这三个字母，总觉得在哪里见过。",
        "evidence_ids": [
          "initials"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "old_student",
        "text": "你教过的学生里，有谁会在乎这间屋子？",
        "answer": "教了三十多年书，学生多得记不清了。只记得有个女孩子，上课总在课本边上画画，画窗外的树，也画我。我没收过她两本课本，后来都还给她了。",
        "evidence_ids": [
          "drawing_student"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "nearby_rumour",
        "text": "邻居说的收楼，和这位买家有关系吗？",
        "answer": "隔壁王太太说，最近有开发商挨家挨户问价，想把这一片都推了盖新楼。她说，出价高的，八成就是他们。",
        "evidence_ids": [
          "developer_rumour"
        ],
        "requires_familiarity": 0
      }
    ],
    [
      {
        "id": "keep_books",
        "text": "买家对屋里的书和家具，有什么要求？",
        "answer": "这倒奇怪。中介转达，买家说家具不用搬，书，一本都不要动。哪有开发商会在乎几架旧书呢。",
        "evidence_ids": [
          "books_stay"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "buying_terms",
        "text": "出价以外，买家还提了什么条件？",
        "answer": "只提了一条：书房保持原样。还说，如果我愿意，可以留一间房自己住。“人生自是有情痴”，买房子的人，我倒头一回见这样的。",
        "evidence_ids": [
          "books_stay"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "house_memory",
        "text": "屋里哪样东西，你最舍不得？",
        "answer": "那架钢琴。他每天晚上弹一曲才肯睡。琴凳我一直没打开过……前几天擦灰的时候才发现，坐垫底下有个小锁孔。我一把钥匙都对不上。",
        "evidence_ids": [
          "stool_lock"
        ],
        "requires_familiarity": 0
      }
    ],
    [
      {
        "id": "husband_habit",
        "text": "他提到第三把钥匙的前后，有什么习惯？",
        "answer": "他每晚弹完琴，总要翻一会儿那本《唐诗三百首》。翻到哪页，第二天就跟我念哪一首。那本书，我也一直没敢翻。",
        "evidence_ids": [
          "poetry_book"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "locked_compartment",
        "text": "钢琴附近，还有没有上锁的地方？",
        "answer": "只有琴凳。坐垫底下那个小锁孔，很小，像给小钥匙准备的。家里那两把大钥匙，都插不进去。",
        "evidence_ids": [
          "stool_lock"
        ],
        "requires_familiarity": 0
      },
      {
        "id": "third_key",
        "text": "‘第三把钥匙留给该来的人’，你都找过哪里？",
        "answer": "花盆底下、抽屉、他的外套口袋，都找过。只有他的书没动。……他总说，要紧的东西，夹在每天会翻的地方，才不会忘。",
        "evidence_ids": [
          "poetry_book"
        ],
        "requires_familiarity": 0
      }
    ]
