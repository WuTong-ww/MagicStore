# User instruction, 2026-11-21: store assets in ordinary Git, without LFS.
*.ttf binary -filter
*.png binary -filter
*.jpg binary -filter
*.jpeg binary -filter
*.ogg binary -filter
*.avi binary -filter
*.wav binary -filter
*.zip binary -filter
